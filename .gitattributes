# Auto detect text files and perform LF normalization
* text=auto

# Windows specific script and project files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
*.xaml text eol=crlf
*.cs text diff=csharp

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.dll binary
*.exe binary
