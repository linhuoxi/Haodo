<Window x:Class="CLIProxyAPI_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Haodo" Height="842" Width="484"
        MinHeight="560" MinWidth="384"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Foreground="{DynamicResource ThemeTextPrimary}"
        FontFamily="Segoe UI Variable Text, Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        RenderOptions.ClearTypeHint="Enabled"
        StateChanged="Window_StateChanged"
        PreviewMouseLeftButtonDown="RootMarginGrid_PreviewMouseLeftButtonDown"
        MouseMove="RootMarginGrid_MouseMove"
        PreviewMouseLeftButtonUp="RootMarginGrid_PreviewMouseLeftButtonUp"
        LostMouseCapture="RootMarginGrid_LostMouseCapture">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Theme Dynamic Brushes -->
        <SolidColorBrush x:Key="ThemeWindowBg" Color="#FAFAFA"/>
        <SolidColorBrush x:Key="ThemeCardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeCardBorder" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="ThemePrimary" Color="#2563EB"/>
        <SolidColorBrush x:Key="ThemeTextPrimary" Color="#0F172A"/>
        <SolidColorBrush x:Key="ThemeTextSecondary" Color="#64748B"/>
        <SolidColorBrush x:Key="ThemeTextTertiary" Color="#94A3B8"/>
        <SolidColorBrush x:Key="ThemeSubtleBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="ThemeInputBg" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="ThemeInputBorder" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="ThemeBtnHeaderBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThemeBtnHeaderFg" Color="#475569"/>
        <SolidColorBrush x:Key="ThemeBtnHeaderBorder" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="ThemeSegmentInactiveFg" Color="#64748B"/>
        <SolidColorBrush x:Key="ThemeSegmentBg" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="ThemeOverlayBg" Color="#80000000"/>
        <SolidColorBrush x:Key="ThemeScrollThumb" Color="#CBD5E1"/>

        <Style x:Key="VergeCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ThemeCardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeCardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.06"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 统一输入框样式：圆角 6 + hover/focus 边框反馈（隐式作用于全部 TextBox） -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemeTextTertiary}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                                <Setter TargetName="bd" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#2563EB" Opacity="0.28"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 可编辑下拉框样式：圆角 6 + 主题配色下拉面板 + 空值占位提示（模型测试用） -->
        <Style x:Key="ComboRoundEditable" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource ThemeInputBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 非编辑模式：选中项显示 -->
                                    <ContentPresenter x:Name="ContentSite" Grid.Column="0" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      IsHitTestVisible="False"/>
                                    <!-- 编辑模式：输入框 -->
                                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="6,0,2,0" Height="30"
                                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                                             BorderThickness="0" Background="Transparent" Foreground="{DynamicResource ThemeTextPrimary}"
                                             FontSize="12" Padding="0,0,0,0" Visibility="Collapsed"/>
                                    <!-- 空值占位提示 -->
                                    <TextBlock x:Name="PlaceholderText" Grid.Column="0" Text="请选择或输入模型..." FontSize="12"
                                               Foreground="{DynamicResource ThemeTextTertiary}" Margin="8,0" VerticalAlignment="Center"
                                               IsHitTestVisible="False" Visibility="Collapsed"/>
                                    <!-- 展开箭头按钮 -->
                                    <ToggleButton Grid.Column="1" x:Name="DropDownToggle" Focusable="False" ClickMode="Press" Width="26" Background="Transparent"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Path Data="M 0 0 L 4 4 L 8 0 Z" Fill="{DynamicResource ThemeTextTertiary}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" StaysOpen="False"
                                   PopupAnimation="Slide" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}"
                                        BorderThickness="1" CornerRadius="6" Padding="3" Margin="0,3,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemeTextTertiary}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ThemePrimary}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BaseBtn" TargetType="Button">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MaxHeight" Value="32"/>
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                <!-- 质感：hover/按下叠加深色层（深浅主题通用，蓝底更饱满、白底微灰） -->
                                <Border x:Name="hoverLayer" Background="Transparent" CornerRadius="5.5" IsHitTestVisible="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="hoverLayer" Property="Background" Value="#0A000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="hoverLayer" Property="Background" Value="#18000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮渐变：垂直由亮到深，质感更饱满（深浅主题统一蓝色系） -->
        <LinearGradientBrush x:Key="ThemeBtnPrimaryGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#2F6FF0" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="0.55"/>
            <GradientStop Color="#1D4ED8" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="BtnPrimary" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ThemeBtnPrimaryGradient}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="BtnHeader" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemeBtnHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeBtnHeaderFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeBtnHeaderBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="BtnSegmentActive" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ThemePrimary}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="BtnSegmentInactive" BasedOn="{StaticResource BaseBtn}" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeSegmentInactiveFg}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- 设置页卡片标题按钮：透明底、左对齐、轻量 hover，无默认按钮边框 -->
        <Style x:Key="SettingsCardHeader" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0A000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 自绘标题栏窗口控制按钮 -->
        <Style x:Key="WindowControlBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ThemeTextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="MaxHeight" Value="26"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowControlBtnClose" BasedOn="{StaticResource WindowControlBtn}" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#C50F1F"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OpacitySlider" TargetType="Slider">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="28" VerticalAlignment="Center">
                            <Track x:Name="PART_Track" VerticalAlignment="Center">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="{DynamicResource ThemePrimary}" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="18" Height="18" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Fill="{DynamicResource ThemeCardBg}" Stroke="{DynamicResource ThemePrimary}" StrokeThickness="2"/>
                                                    <Ellipse Width="6" Height="6" Fill="{DynamicResource ThemePrimary}"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="{DynamicResource ThemeInputBorder}" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
            <Setter Property="Width" Value="5"/>
            <Setter Property="Height" Value="5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="True">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsMouseOver}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Visibility="Collapsed"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="thumbBd" Background="{DynamicResource ThemeScrollThumb}" CornerRadius="2.5"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="thumbBd" Property="Background" Value="#94A3B8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Visibility="Collapsed"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OverlayScrollViewer" TargetType="ScrollViewer">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid x:Name="Grid" Background="{TemplateBinding Background}">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0" Value="{TemplateBinding VerticalOffset}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootMarginGrid" Background="Transparent">
        <Border x:Name="RootBorder" Margin="16" CornerRadius="12" Background="{DynamicResource ThemeWindowBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1">
            <Border.Effect>
                <!-- 阴影扩散范围控制在容器透明边距内，避免被窗口边界裁切出硬边 -->
                <DropShadowEffect x:Name="RootShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.14" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 0. 自绘标题栏 (左：品牌与拖动区 / 右：快捷操作与窗口控制) -->
                <Grid x:Name="TitleBar" Height="42" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：品牌 + 拖动区（双击最大化） -->
                    <Grid Grid.Column="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <Border Width="10" Height="10" CornerRadius="5" Background="{DynamicResource ThemePrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Haodo" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <!-- 右：窗口控制 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border Width="1" Height="18" Background="{DynamicResource ThemeCardBorder}" Margin="0,0,6,0"/>
                        <Button x:Name="BtnWindowMinimize" Click="BtnWindowMinimize_Click" Style="{StaticResource WindowControlBtn}" ToolTip="最小化">
                            <Path Data="M 3,7.5 L 13,7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="16" Height="15" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="BtnWindowClose" Click="BtnWindowClose_Click" Style="{StaticResource WindowControlBtnClose}" ToolTip="关闭">
                            <Path Data="M 3,3 L 13,13 M 13,3 L 3,13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Width="16" Height="16" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- 标题栏底部分隔线：强化内容层级 -->
                    <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource ThemeCardBorder}" Opacity="0.7"/>
                </Grid>

                <!-- MAIN APP CONTENT -->
                <Grid Grid.Row="1" Margin="14,14,14,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

            <!-- 2. TOP COMBINED NAVIGATION CARD (第二排：顶部品牌导航栏) -->
            <Border Grid.Row="0" Style="{StaticResource VergeCard}" Margin="0,0,0,12" Padding="0" HorizontalAlignment="Stretch">
                <Grid x:Name="GridTopNavContent" Margin="14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：品牌侧标 + 实心徽章 + 账号计数 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 品牌侧标：品牌蓝竖条 -->
                        <Border x:Name="BarNavBrand" Width="4" Height="30" CornerRadius="2" Background="#2563EB" Margin="0,0,12,0" VerticalAlignment="Center"/>

                        <!-- 就绪徽章：实心品牌蓝底 + 白字 -->
                        <Border x:Name="BadgeSystemReady" Background="{DynamicResource ThemePrimary}" CornerRadius="6" Padding="9,3" Margin="0,0,10,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#FFFFFF" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="6" ShadowDepth="0" Color="#FFFFFF" Opacity="0.8"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="TxtSystemReady" Text="SYSTEM READY" FontSize="10" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- 分隔线 -->
                        <Border x:Name="BorderNavSep" Width="1" Height="16" Background="{DynamicResource ThemeCardBorder}" Margin="0,0,10,0" VerticalAlignment="Center"/>

                        <!-- 账号计数：大号品牌色数字 + 小标签 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtAccountCount" Text="0" FontSize="17" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtAccountUnit" Text="个账号" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="5,0,0,1" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 右侧：品牌化分段导航 (图标 + 文字) -->
                    <Border Grid.Column="1" Background="{DynamicResource ThemeSegmentBg}" CornerRadius="7" Padding="2" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnNavMain" Grid.Column="0" Click="BtnNavMain_Click" Style="{StaticResource BtnSegmentActive}" Height="26" Padding="12,0" Margin="0,0,2,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE80F;" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="TxtNavMain" Text="主界面" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnNavSettings" Grid.Column="1" Click="BtnNavSettings_Click" Style="{StaticResource BtnSegmentInactive}" Height="26" Padding="12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11" Text="&#xE713;" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                        <TextBlock x:Name="TxtNavSettings" Text="设置" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                </Grid>
            </Border>

            <!-- 3. PAGE VIEW CONTAINER (页面区) -->
            <Grid Grid.Row="1">

                <!-- PAGE 1: VIEW MAIN (主界面) -->
                <Grid x:Name="ViewMain" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. 上部：凭证卡片专属【圆角矩形容器】 (将滚动凭证卡片完美收纳于独立圆角槽内部) -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource ThemeSubtleBg}"
                            BorderBrush="{DynamicResource ThemeCardBorder}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="8,8,8,8"
                            Margin="0,0,0,10"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                            <Grid Margin="0,0,0,0">
                                <!-- A. 账号卡片容器 -->
                                <StackPanel x:Name="QuotaAccountsContainer" HorizontalAlignment="Stretch"/>

                                <!-- B. 暂无凭证空状态引导卡片 (颠覆性极简重构) -->
                                <Border x:Name="EmptyStateContainer" Visibility="Collapsed" Style="{StaticResource VergeCard}" Padding="24,36" Margin="0,2,0,10" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- 极简科技冷调空状态标牌 -->
                                        <Border Background="{DynamicResource ThemeSubtleBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,4" HorizontalAlignment="Center" Margin="0,0,0,14">
                                            <TextBlock Text="NO CREDENTIALS FOUND" FontSize="10" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" Foreground="{DynamicResource ThemeTextTertiary}" HorizontalAlignment="Center"/>
                                        </Border>
                                        
                                        <TextBlock Text="暂未导入账号凭证" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                        <TextBlock Text="当前数据目录中未检测到 Gemini / Antigravity 的凭证 JSON 文件。&#10;你可以通过以下方式快速开始使用：" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,22" LineHeight="18"/>
                                        
                                        <!-- 双按钮组 -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                            <Button Click="BtnGeminiLogin_Click" Style="{StaticResource BtnPrimary}" Height="34" MinHeight="34" MaxHeight="34" Padding="16,0" FontSize="12" Cursor="Hand" Margin="0,0,10,0">
                                                <TextBlock x:Name="TxtEmptyLogin" Text="登录 Google 获取凭证 (Gemini)" VerticalAlignment="Center"/>
                                            </Button>
                                            <Button Click="BtnAddFiles_Click" Style="{StaticResource BtnHeader}" Height="34" MinHeight="34" MaxHeight="34" Padding="16,0" FontSize="12" Cursor="Hand">
                                                <TextBlock x:Name="TxtEmptyImport" Text="导入 JSON 凭证" VerticalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- 底部隐私提示槽 -->
                                        <Border x:Name="EmptyPrivacyTip" Background="{DynamicResource ThemeSubtleBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,7" HorizontalAlignment="Center">
                                            <TextBlock Text="🔒 所有凭证集中加密存储于本地数据目录，绝不外发无关服务器。" FontSize="11" Foreground="{DynamicResource ThemeTextTertiary}" HorizontalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- 2. 下部：运行日志 VergeCard 独立卡片 + 快捷控制底栏 -->
                    <Grid Grid.Row="1" Margin="0,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 2.1 运行日志 VergeCard 独立固定卡片 -->
                        <Border Grid.Row="0" Style="{StaticResource VergeCard}" Margin="0,0,0,10" Padding="12,10">
                            <StackPanel HorizontalAlignment="Stretch">
                                <!-- 头部：标题与清空/复制/展开折叠 -->
                                <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonUp="BtnToggleLog_Click">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtLogToggleTitle" Text="运行日志" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Click="BtnClearLog_Click" Style="{StaticResource BtnHeader}" Height="22" MinHeight="22" MaxHeight="22" Padding="6,0" FontSize="10" Margin="0,0,4,0">清空</Button>
                                        <Button Click="BtnCopyLog_Click" Style="{StaticResource BtnHeader}" Height="22" MinHeight="22" MaxHeight="22" Padding="6,0" FontSize="10" Margin="0,0,8,0">复制</Button>
                                        <TextBlock x:Name="TxtLogArrow" Text="v" FontSize="10" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- 展开显示的日志终端体 -->
                                <Border x:Name="LogPanelContainer" Visibility="Collapsed" Background="#0F172A" CornerRadius="8" Padding="8" Height="140" Margin="0,10,0,0">
                                    <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                                        <TextBox x:Name="TxtLog" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" Foreground="#E2E8F0" BorderThickness="0" Padding="0" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 2.2 快捷控制栏：刷新配额 + 登录 Gemini + HTTP 代理状态灯 -->
                        <Grid Grid.Row="1" Margin="0,0,0,0">
                            <!-- 左下角最下面：刷新配额 + 登录 Gemini -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="BtnRefreshQuota" Click="BtnRefreshQuota_Click" Style="{StaticResource BtnPrimary}" Height="28" MinHeight="28" MaxHeight="28" Padding="10,0" FontSize="12" Margin="0,0,6,0" ToolTip="立即刷新所有账号的配额">
                                    <TextBlock x:Name="TxtRefreshBtn" Text="刷新配额" VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnGeminiLoginBottom" Click="BtnGeminiLogin_Click" Style="{StaticResource BtnHeader}" Height="28" MinHeight="28" MaxHeight="28" Padding="10,0" FontSize="12" ToolTip="在线登录 Google 账号，自动获取并保存 Gemini 凭证 JSON">
                                    <TextBlock x:Name="TxtGeminiLoginBottom" Text="登录 Gemini" VerticalAlignment="Center"/>
                                </Button>
                            </StackPanel>

                            <!-- 右下角：HTTP 代理状态灯 -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Cursor="Hand" ToolTip="本地 API 代理 (HTTP 8317) 运行状态，点击前往设置" MouseLeftButtonUp="DotLocalProxyStatus_Click">
                                <Ellipse x:Name="DotLocalProxyStatus" Width="10" Height="10" Fill="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtLocalProxyDotStatus" Text="HTTP 代理未开启" FontSize="12" Foreground="{DynamicResource ThemeTextTertiary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- PAGE 2: VIEW SETTINGS (设置页：原生嵌在主窗口中，不再独立弹窗) -->
                <Grid x:Name="ViewSettings" Visibility="Collapsed">
                    <ScrollViewer Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Stretch" Margin="0,0,0,0">

        <!-- 本地 API 代理（置顶，默认收起；头部与折叠交互与其他卡片完全一致，仅布局不同：标题|徽章|运行|停止|箭头） -->
        <Border Style="{StaticResource VergeCard}" Padding="0" HorizontalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True">
                <!-- 头部：整行可点击折叠（同其他卡片）；标题靠左、箭头最右对齐、徽章+运行+停止靠右 -->
                <Button Click="ToggleSettingsSection_Click" Tag="SettingsLocalProxyContent|TxtArrowLocalProxy" Style="{StaticResource SettingsCardHeader}">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="本地 API 代理" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="14,11,0,11"/>
                        <!-- 弹性空白：点击此区域同样触发折叠 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource ThemeSegmentBg}" CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtLocalProxyStatusBadge" Text="已停止" FontSize="11" Foreground="{DynamicResource ThemeTextTertiary}"/>
                            </Border>
                            <Border Background="{DynamicResource ThemeSegmentBg}" CornerRadius="10" Padding="3" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnLocalProxyOn" Click="BtnLocalProxyOn_Click" Style="{StaticResource BtnHeader}" Height="26" MinHeight="26" MaxHeight="26" Padding="10,0" ToolTip="启动本地代理 HTTP 端口">
                                        <TextBlock Text="运行" FontSize="11" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button x:Name="BtnLocalProxyOff" Grid.Column="1" Click="BtnLocalProxyOff_Click" Style="{StaticResource BtnHeader}" Height="26" MinHeight="26" MaxHeight="26" Padding="10,0" Margin="2,0,0,0" ToolTip="停止本地代理 HTTP 端口">
                                        <TextBlock Text="停止" FontSize="11" VerticalAlignment="Center"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <!-- 箭头：与其他卡片同款，固定最右缘 -->
                        <TextBlock Grid.Column="3" x:Name="TxtArrowLocalProxy" Text="▶" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" VerticalAlignment="Center" Margin="12,0,14,0"/>
                    </Grid>
                </Button>

                <!-- 内容区（默认折叠，点击标题展开） -->
                <StackPanel x:Name="SettingsLocalProxyContent" Visibility="Collapsed" HorizontalAlignment="Stretch">

                <!-- 描述 -->
                <TextBlock Text="本机 AI 客户端（NextChat、Cherry Studio、Cursor 等）可直连此代理。" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="14,10,14,0"/>

                <!-- 连接配置 -->
                <TextBlock Text="连接配置" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="14,14,14,8"/>
                <Grid Margin="14,0,14,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProxyKeyBtn"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProxyKeyBtn"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="API Key" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtLocalProxyApiKey" Grid.Column="1" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource ThemeTextPrimary}" Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" Padding="8,4" Height="32" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch" LostFocus="TxtLocalProxyApiKey_LostFocus" KeyDown="TxtLocalProxyApiKey_KeyDown" ToolTip="留空表示不需要 Key 鉴权"/>
                    <Button Grid.Column="2" Click="BtnGenLocalProxyKey_Click" Style="{StaticResource BtnHeader}" Height="32" MinHeight="32" MaxHeight="32" Padding="10,0" Margin="6,0,0,0" ToolTip="随机生成 API Key">
                        <TextBlock Text="随机" FontSize="12" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="3" Click="BtnCopyLocalProxyKey_Click" Style="{StaticResource BtnHeader}" Height="32" MinHeight="32" MaxHeight="32" Padding="10,0" Margin="6,0,0,0" ToolTip="复制 API Key">
                        <TextBlock Text="复制" FontSize="12" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <Grid Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProxyKeyBtn"/>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="ProxyKeyBtn"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Base URL" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                    <!-- URL 地址胶囊：外层圆角矩形包住完整地址，端口输入框为内层小圆角矩形 -->
                    <Border Grid.Column="1" Background="{DynamicResource ThemeSubtleBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Height="32" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtLocalProxyUrlPrefix" Text="http://127.0.0.1:" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="10,0,4,0"/>
                            <TextBox x:Name="TxtLocalProxyPort" Grid.Column="1" Text="8317" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" Padding="2,0" Height="24" TextAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch" TextChanged="TxtLocalProxyPort_TextChanged" LostFocus="TxtLocalProxyPort_LostFocus" KeyDown="TxtLocalProxyPort_KeyDown" ToolTip="本地代理监听端口"/>
                            <TextBlock Grid.Column="2" Text="/v1" FontSize="12" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="4,0,10,0"/>
                        </Grid>
                    </Border>
                    <Button Grid.Column="2" Grid.ColumnSpan="2" Click="BtnCopyLocalProxyUrl_Click" Style="{StaticResource BtnHeader}" Height="32" MinHeight="32" MaxHeight="32" Padding="10,0" HorizontalAlignment="Stretch" ToolTip="复制完整接口地址到剪贴板">
                        <TextBlock x:Name="TxtCopyLocalProxyUrl" Text="复制 URL" FontSize="12" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- 分隔线 -->
                <Border Height="1" Background="{DynamicResource ThemeCardBorder}" Margin="14,12,14,12"/>

                <!-- 模型测试 -->
                <TextBlock Text="模型测试" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="14,0,14,8"/>
                <Grid Margin="14,0,14,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbLocalProxyModel" Grid.Column="0" Style="{StaticResource ComboRoundEditable}" IsEditable="True" Height="32" FontSize="12" HorizontalAlignment="Stretch" ToolTip="选择或输入要测试的模型"/>
                    <Button Grid.Column="1" x:Name="BtnFetchLocalProxyModels" Click="BtnFetchLocalProxyModels_Click" Style="{StaticResource BtnHeader}" Height="32" MinHeight="32" MaxHeight="32" Padding="10,0" Margin="6,0,0,0" ToolTip="从本地代理获取可用模型列表">
                        <TextBlock x:Name="TxtFetchLocalProxyModels" Text="获取模型" FontSize="12" VerticalAlignment="Center"/>
                    </Button>
                    <Button Grid.Column="2" x:Name="BtnTestLocalProxyModel" Click="BtnTestLocalProxyModel_Click" Style="{StaticResource BtnPrimary}" Height="32" MinHeight="32" MaxHeight="32" Padding="10,0" Margin="6,0,0,0" ToolTip="向选中模型发送一段自我介绍请求以验证连通性">
                        <TextBlock Text="测试" FontSize="12" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <!-- 结果框：状态行 + 回复内容 -->
                <Border Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="14,0,14,14">
                    <StackPanel>
                        <TextBlock x:Name="TxtLocalProxyTestStatus" Text="尚未测试" FontSize="11" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource ThemeTextTertiary}" Margin="0,0,0,5"/>
                        <TextBlock x:Name="TxtLocalProxyTestResult" Text="选择模型后点击「测试」验证连通性。" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </StackPanel>
        </Border>

                            <!-- 外观 -->
                            <Border Style="{StaticResource VergeCard}" Padding="0" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Button Click="ToggleSettingsSection_Click" Tag="SettingsThemeContent|TxtArrowTheme" Style="{StaticResource SettingsCardHeader}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="外观" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="14,11,0,11"/>
                                            <TextBlock x:Name="TxtArrowTheme" Grid.Column="1" Text="▶" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Grid>
                                    </Button>
                                    <StackPanel x:Name="SettingsThemeContent" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="14,0,14,12">
                                        <TextBlock Text="界面主题，可跟随系统。" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <Border Background="{DynamicResource ThemeSegmentBg}" CornerRadius="8" Padding="3" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnThemeSystem" Click="BtnThemeSystem_Click" Content="跟随系统" Style="{StaticResource BtnHeader}" Margin="0,0,2,0" HorizontalAlignment="Stretch"/>
                                                <Button x:Name="BtnThemeDark" Grid.Column="1" Click="BtnThemeDark_Click" Content="深色" Style="{StaticResource BtnHeader}" Margin="2,0,2,0" HorizontalAlignment="Stretch"/>
                                                <Button x:Name="BtnThemeLight" Grid.Column="2" Click="BtnThemeLight_Click" Content="浅色" Style="{StaticResource BtnHeader}" Margin="2,0,0,0" HorizontalAlignment="Stretch"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 隐私脱敏 -->
                            <Border Style="{StaticResource VergeCard}" Padding="0" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Button Click="ToggleSettingsSection_Click" Tag="SettingsMaskContent|TxtArrowMask" Style="{StaticResource SettingsCardHeader}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="隐私脱敏" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="14,11,0,11"/>
                                            <TextBlock x:Name="TxtArrowMask" Grid.Column="1" Text="▶" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Grid>
                                    </Button>
                                    <StackPanel x:Name="SettingsMaskContent" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="14,0,14,12">
                                        <TextBlock Text="隐藏账号邮箱中间部分（如 bend****26@gmail.com），防止截屏泄露。" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <Border Background="{DynamicResource ThemeSegmentBg}" CornerRadius="8" Padding="3" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnMaskAccountOff" Click="BtnMaskAccountOff_Click" Content="关闭" Style="{StaticResource BtnHeader}" Margin="0,0,2,0" HorizontalAlignment="Stretch" ToolTip="显示完整邮箱"/>
                                                <Button x:Name="BtnMaskAccountOn" Grid.Column="1" Click="BtnMaskAccountOn_Click" Content="开启" Style="{StaticResource BtnHeader}" Margin="2,0,0,0" HorizontalAlignment="Stretch" ToolTip="隐藏邮箱中间部分"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 数据目录 -->
                            <Border Style="{StaticResource VergeCard}" Padding="0" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Button Click="ToggleSettingsSection_Click" Tag="SettingsDataDirContent|TxtArrowDataDir" Style="{StaticResource SettingsCardHeader}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="数据目录" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="14,11,0,11"/>
                                            <TextBlock x:Name="TxtArrowDataDir" Grid.Column="1" Text="▶" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Grid>
                                    </Button>
                                    <StackPanel x:Name="SettingsDataDirContent" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="14,0,14,12">
                                        <TextBlock Text="凭证与配置文件保存在此目录。支持自定义到网盘同步盘或非系统盘。" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        
                                        <!-- 数据统计概况条 -->
                                        <Border Background="{DynamicResource ThemeSubtleBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TxtDataDirStat" Text="数据统计加载中..." FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="1" Click="BtnSetPortableDataDir_Click" Style="{StaticResource BtnHeader}" Height="22" Padding="6,0" FontSize="11" ToolTip="快捷设为程序运行目录下的 data 文件夹（便携便携版使用）">
                                                    <TextBlock x:Name="TxtPortableDataDir" Text="便携模式 (./data)" VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- 路径及内嵌浏览按钮、刷新、打开、恢复默认 -->
                                        <Grid Margin="0,0,0,0" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- 内嵌 📂 选择文件夹按钮的路径输入框容器 -->
                                            <Grid Grid.Column="0" HorizontalAlignment="Stretch">
                                                <TextBox x:Name="TxtDataDir" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" Padding="8,4,30,4" Height="32" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch" LostFocus="TxtDataDir_LostFocus" KeyDown="TxtDataDir_KeyDown" ToolTip="输入路径后按 Enter 保存，或点击右侧 📂 图标选择"/>
                                                <Button Click="BtnBrowseDataDir_Click" Style="{StaticResource BtnHeader}" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Padding="0" BorderThickness="0" Background="Transparent" Cursor="Hand" ToolTip="浏览并选择数据目录">
                                                    <TextBlock Text="📂" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Button>
                                            </Grid>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,0,0,0">
                                                <Button x:Name="BtnRefreshDataDir" Click="BtnRefreshDataDir_Click" Style="{StaticResource BtnHeader}" Height="32" MinHeight="32" MaxHeight="32" Padding="10,0" Margin="0,0,4,0" ToolTip="重新扫描并读取当前目录中的凭证与数据文件">
                                                    <TextBlock Text="刷新" FontSize="12" VerticalAlignment="Center"/>
                                                </Button>
                                                <Button x:Name="BtnOpenDataDir" Click="BtnOpenDataDir_Click" Style="{StaticResource BtnHeader}" Height="32" MinHeight="32" MaxHeight="32" Padding="10,0" Margin="0,0,4,0" ToolTip="在资源管理器中打开">
                                                    <TextBlock Text="打开" FontSize="12" VerticalAlignment="Center"/>
                                                </Button>
                                                <Button x:Name="BtnResetDefaultDataDir" Click="BtnResetDefaultDataDir_Click" Style="{StaticResource BtnHeader}" Height="32" MinHeight="32" MaxHeight="32" Padding="10,0" ToolTip="恢复为默认 data 路径（软件同级 data 文件夹）">
                                                    <TextBlock x:Name="TxtResetDefaultDataDir" Text="恢复默认" FontSize="12" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- 分割线：下方为云同步区（Google Drive 备份与恢复） -->
                                        <Border Height="1" Background="{DynamicResource ThemeCardBorder}" Margin="0,12,0,12"/>

                                        <Grid Margin="0,0,0,4" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="云同步 (Google Drive)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource ThemeSubtleBg}" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                                <TextBlock x:Name="TxtGDriveStatusBadge" Text="未连接" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeTextTertiary}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="将偏好配置与 Gemini 凭证文件备份至你的 Google Drive 私有空间，跨设备手动同步。凭证仅在你的账号私有空间内保存。" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                                        <!-- 未连接：登录 -->
                                        <StackPanel x:Name="SettingsSyncLoginRow" HorizontalAlignment="Stretch">
                                            <Button x:Name="BtnGoogleLogin" Click="BtnGoogleLogin_Click" Style="{StaticResource BtnPrimary}" Height="32" Padding="0" HorizontalAlignment="Stretch">
                                                <TextBlock Text="登录 Google" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- 已连接：头像 + 账号信息 + 操作按钮 + 进度条 -->
                                        <StackPanel x:Name="SettingsSyncConnectedRow" Visibility="Collapsed" HorizontalAlignment="Stretch">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- 圆形头像（Google 头像图片 + 首字母兜底） -->
                                                <Border x:Name="GDriveAvatarBorder" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource ThemePrimary}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <Grid>
                                                        <Image x:Name="GDriveAvatarImage" Visibility="Collapsed" Stretch="UniformToFill"/>
                                                        <TextBlock x:Name="GDriveAvatarFallback" Text="G" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                    <Border.Clip>
                                                        <EllipseGeometry RadiusX="22" RadiusY="22" Center="22,22"/>
                                                    </Border.Clip>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtGDriveUserEmail" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock x:Name="TxtGDriveLastSync" Text="尚未同步" FontSize="11" Foreground="{DynamicResource ThemeTextTertiary}" Margin="0,2,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Button x:Name="BtnGDriveUpload" Click="BtnGDriveUpload_Click" Style="{StaticResource BtnPrimary}" Height="30" MinHeight="30" MaxHeight="30" Padding="10,0" Margin="0,0,4,0" ToolTip="将偏好配置与凭证上传到 Google Drive">
                                                        <TextBlock Text="上传" FontSize="12" VerticalAlignment="Center"/>
                                                    </Button>
                                                    <Button x:Name="BtnGDriveDownload" Click="BtnGDriveDownload_Click" Style="{StaticResource BtnHeader}" Height="30" MinHeight="30" MaxHeight="30" Padding="10,0" Margin="0,0,4,0" ToolTip="从 Google Drive 恢复配置与凭证到当前数据目录">
                                                        <TextBlock Text="恢复" FontSize="12" VerticalAlignment="Center"/>
                                                    </Button>
                                                    <Button x:Name="BtnGDriveLogout" Click="BtnGDriveLogout_Click" Style="{StaticResource BtnHeader}" Height="30" MinHeight="30" MaxHeight="30" Padding="10,0" ToolTip="断开 Google 连接">
                                                        <TextBlock Text="断开" FontSize="12" VerticalAlignment="Center"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- 同步进度区（busy 时显示） -->
                                            <StackPanel x:Name="GDriveBusyPanel" Visibility="Collapsed" Margin="0,10,0,0">
                                                <ProgressBar x:Name="GDriveProgress" Height="4" IsIndeterminate="True" Foreground="{DynamicResource ThemePrimary}" Background="{DynamicResource ThemeSubtleBg}" BorderThickness="0"/>
                                                <TextBlock x:Name="TxtGDriveBusyText" Text="正在同步…" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 自动刷新 -->
                            <Border Style="{StaticResource VergeCard}" Padding="0" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Button Click="ToggleSettingsSection_Click" Tag="SettingsAutoRefreshContent|TxtArrowAutoRefresh" Style="{StaticResource SettingsCardHeader}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="自动刷新" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="14,11,0,11"/>
                                            <TextBlock x:Name="TxtArrowAutoRefresh" Grid.Column="1" Text="▶" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Grid>
                                    </Button>
                                    <StackPanel x:Name="SettingsAutoRefreshContent" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="14,0,14,12">
                                        <TextBlock Text="配额刷新间隔，填 0 表示关闭。" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="间隔" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBox x:Name="TxtAutoRefreshInterval" Grid.Column="1" Text="5" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" Background="{DynamicResource ThemeInputBg}" BorderBrush="{DynamicResource ThemeInputBorder}" BorderThickness="1" Padding="8,4" Height="32" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch" LostFocus="TxtAutoRefreshInterval_LostFocus" KeyDown="TxtAutoRefreshInterval_KeyDown"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                                                <TextBlock Text="分钟" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Click="BtnSaveAutoRefresh_Click" Style="{StaticResource BtnPrimary}" Height="32" MinHeight="32" MaxHeight="32" Padding="12,0" FontSize="12">
                                                    <TextBlock Text="保存" VerticalAlignment="Center"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 贴贴 -->
                            <Border Style="{StaticResource VergeCard}" Padding="0" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Button Click="ToggleSettingsSection_Click" Tag="SettingsMiniContent|TxtArrowMini" Style="{StaticResource SettingsCardHeader}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="贴贴" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="14,11,0,11"/>
                                            <TextBlock x:Name="TxtArrowMini" Grid.Column="1" Text="▶" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Grid>
                                    </Button>
                                    <StackPanel x:Name="SettingsMiniContent" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="14,0,14,12">
                                        <TextBlock Text="显示模式与卡片配色。" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        
                                        <!-- 模式选择分段按钮 -->
                                        <Border Background="{DynamicResource ThemeSegmentBg}" CornerRadius="8" Padding="3" HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="BtnModeOff" Click="BtnModeOff_Click" Content="关闭" Style="{StaticResource BtnHeader}" Margin="0,0,2,0" HorizontalAlignment="Stretch" ToolTip="隐藏贴贴"/>
                                                <Button x:Name="BtnModeTaskbar" Grid.Column="1" Click="BtnModeTaskbar_Click" Content="任务栏贴" Style="{StaticResource BtnHeader}" Margin="2,0,2,0" HorizontalAlignment="Stretch" ToolTip="贴附在任务栏上"/>
                                                <Button x:Name="BtnModeFloating" Grid.Column="2" Click="BtnModeFloating_Click" Content="桌面悬浮" Style="{StaticResource BtnHeader}" Margin="2,0,0,0" HorizontalAlignment="Stretch" ToolTip="悬浮在桌面上"/>
                                            </Grid>
                                        </Border>

                                        <!-- 强调色 -->
                                        <TextBlock Text="强调色" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,2"/>
                                        <TextBlock Text="用于图标、文字与配额进度。" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                                        <Grid HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <WrapPanel x:Name="PanelAccentPresets" VerticalAlignment="Center">
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#FFFFFF" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Margin="0,0,6,0" Cursor="Hand" ToolTip="极简白 (#FFFFFF)" MouseLeftButtonUp="BtnColorPreset_Click" Tag="#FFFFFF"/>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#3572EF" Margin="0,0,6,0" Cursor="Hand" ToolTip="耀蓝 (#3572EF)" MouseLeftButtonUp="BtnColorPreset_Click" Tag="#3572EF"/>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#10B981" Margin="0,0,6,0" Cursor="Hand" ToolTip="翡翠绿 (#10B981)" MouseLeftButtonUp="BtnColorPreset_Click" Tag="#10B981"/>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#8B5CF6" Margin="0,0,6,0" Cursor="Hand" ToolTip="魅紫 (#8B5CF6)" MouseLeftButtonUp="BtnColorPreset_Click" Tag="#8B5CF6"/>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#F97316" Margin="0,0,6,0" Cursor="Hand" ToolTip="暖橘 (#F97316)" MouseLeftButtonUp="BtnColorPreset_Click" Tag="#F97316"/>
                                                <Border Width="22" Height="22" CornerRadius="11" Background="#F43F5E" Margin="0,0,6,0" Cursor="Hand" ToolTip="玫瑰红 (#F43F5E)" MouseLeftButtonUp="BtnColorPreset_Click" Tag="#F43F5E"/>
                                            </WrapPanel>
                                            <Button Grid.Column="1" Click="BtnOpenColorPicker_Click" Style="{StaticResource BtnHeader}" Height="32" MinHeight="32" MaxHeight="32" Padding="8,0" FontSize="12" ToolTip="自定义强调色">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border x:Name="BorderCurrentColorPreview" Width="12" Height="12" CornerRadius="6" Background="#FFFFFF" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Margin="0,0,6,0"/>
                                                    <TextBlock x:Name="TxtMiniWidgetColorDisplay" Text="#FFFFFF" FontSize="12" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- 桌面悬浮专属面板 -->
                                        <StackPanel x:Name="PanelFloatingSettings" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0,4,0,0">
                                            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ThemeCardBorder}" Margin="0,0,0,10"/>

                                            <!-- 背景色 -->
                                            <TextBlock Text="背景色" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,2"/>
                                            <TextBlock Text="仅用于桌面悬浮卡片。" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" TextWrapping="Wrap" Margin="0,0,0,7"/>
                                            <Grid HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <WrapPanel x:Name="PanelBackgroundPresets" VerticalAlignment="Center">
                                                    <Border Width="22" Height="22" CornerRadius="11" Background="#101418" BorderBrush="#334155" BorderThickness="1" Margin="0,0,6,0" Cursor="Hand" ToolTip="墨黑 (#101418)" MouseLeftButtonUp="BtnBgColorPreset_Click" Tag="#101418"/>
                                                    <Border Width="22" Height="22" CornerRadius="11" Background="#12365A" BorderBrush="#315D87" BorderThickness="1" Margin="0,0,6,0" Cursor="Hand" ToolTip="深海蓝 (#12365A)" MouseLeftButtonUp="BtnBgColorPreset_Click" Tag="#12365A"/>
                                                    <Border Width="22" Height="22" CornerRadius="11" Background="#184E3B" BorderBrush="#32745C" BorderThickness="1" Margin="0,0,6,0" Cursor="Hand" ToolTip="松柏绿 (#184E3B)" MouseLeftButtonUp="BtnBgColorPreset_Click" Tag="#184E3B"/>
                                                    <Border Width="22" Height="22" CornerRadius="11" Background="#4A255F" BorderBrush="#714187" BorderThickness="1" Margin="0,0,6,0" Cursor="Hand" ToolTip="暮光紫 (#4A255F)" MouseLeftButtonUp="BtnBgColorPreset_Click" Tag="#4A255F"/>
                                                    <Border Width="22" Height="22" CornerRadius="11" Background="#6B2839" BorderBrush="#91465A" BorderThickness="1" Margin="0,0,6,0" Cursor="Hand" ToolTip="酒红 (#6B2839)" MouseLeftButtonUp="BtnBgColorPreset_Click" Tag="#6B2839"/>
                                                    <Border Width="22" Height="22" CornerRadius="11" Background="#F4F1EA" BorderBrush="#CBD5E1" BorderThickness="1" Margin="0,0,6,0" Cursor="Hand" ToolTip="柔白 (#F4F1EA)" MouseLeftButtonUp="BtnBgColorPreset_Click" Tag="#F4F1EA"/>
                                                </WrapPanel>
                                                <Button Grid.Column="1" Click="BtnOpenBgColorPicker_Click" Style="{StaticResource BtnHeader}" Height="32" MinHeight="32" MaxHeight="32" Padding="8,0" FontSize="12" ToolTip="自定义背景色">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border x:Name="BorderCurrentBgColorPreview" Width="12" Height="12" CornerRadius="6" Background="#161B22" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" Margin="0,0,6,0"/>
                                                        <TextBlock x:Name="TxtMiniWidgetBgColorDisplay" Text="#161B22" FontSize="12" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <!-- 背景不透明度 -->
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="不透明度" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                    <TextBlock Text="拖动滑块实时预览。" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Slider x:Name="SliderBgOpacity" Grid.Column="1" Style="{StaticResource OpacitySlider}" Minimum="0" Maximum="100" Value="85" SmallChange="1" LargeChange="10" VerticalAlignment="Center" ValueChanged="SliderBgOpacity_ValueChanged"/>
                                                <Border Grid.Column="2" MinWidth="44" Height="26" Margin="10,0,0,0" Padding="7,0" Background="{DynamicResource ThemeSubtleBg}" CornerRadius="6" VerticalAlignment="Center">
                                                    <TextBlock x:Name="TxtBgOpacityVal" Text="85%" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center" TextAlignment="Center"/>
                                                </Border>
                                            </Grid>

                                            <!-- 贴边自动收纳 -->
                                            <Grid HorizontalAlignment="Stretch" Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="贴边自动收纳" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                    <TextBlock Text="贴紧屏幕边缘后收纳，不主动吸附。" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource ThemeSegmentBg}" CornerRadius="7" Padding="3" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44"/>
                                                            <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="BtnEdgeDockOff" Click="BtnEdgeDockOff_Click" Content="关闭" Style="{StaticResource BtnSegmentInactive}" Height="26" Padding="5,0"/>
                                                        <Button x:Name="BtnEdgeDockOn" Grid.Column="1" Click="BtnEdgeDockOn_Click" Content="开启" Style="{StaticResource BtnSegmentActive}" Height="26" Padding="5,0"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <!-- 隐藏圆角矩形 -->
                                            <Grid HorizontalAlignment="Stretch" Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="隐藏圆角矩形" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}"/>
                                                    <TextBlock Text="隐藏卡片圆角背景与边框，只保留配额文字内容。" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="{DynamicResource ThemeSegmentBg}" CornerRadius="7" Padding="3" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="44"/>
                                                            <ColumnDefinition Width="44"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="BtnHideCardBgOff" Click="BtnHideCardBgOff_Click" Content="关闭" Style="{StaticResource BtnSegmentInactive}" Height="26" Padding="5,0"/>
                                                        <Button x:Name="BtnHideCardBgOn" Grid.Column="1" Click="BtnHideCardBgOn_Click" Content="开启" Style="{StaticResource BtnSegmentActive}" Height="26" Padding="5,0"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 凭证文件 -->
                            <Border Style="{StaticResource VergeCard}" Padding="0" HorizontalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Button Click="ToggleSettingsSection_Click" Tag="SettingsFilesContent|TxtArrowFiles" Style="{StaticResource SettingsCardHeader}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TxtSettingsFileCount" Text="凭证文件 (0)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="14,11,0,11"/>
                                            <TextBlock x:Name="TxtArrowFiles" Grid.Column="1" Text="▶" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Grid>
                                    </Button>
                                    <StackPanel x:Name="SettingsFilesContent" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="14,0,14,12">
                                        <Grid Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Click="BtnGeminiLogin_Click" Style="{StaticResource BtnHeader}" Height="32" Padding="0" Margin="0,0,4,0" HorizontalAlignment="Stretch">
                                                <TextBlock Text="登录 Gemini" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                            <Button Grid.Column="1" Click="BtnAddFiles_Click" Style="{StaticResource BtnPrimary}" Height="32" Padding="0" Margin="4,0,0,0" HorizontalAlignment="Stretch">
                                                <TextBlock Text="导入 JSON" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                        <StackPanel x:Name="SettingsFilesContainer" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- 关于 -->
                            <Border Style="{StaticResource VergeCard}" Padding="0" HorizontalAlignment="Stretch" Margin="0,0,0,0">
                                <StackPanel HorizontalAlignment="Stretch">
                                    <Button Click="ToggleSettingsSection_Click" Tag="SettingsAboutContent|TxtArrowAbout" Style="{StaticResource SettingsCardHeader}">
                                        <Grid HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="关于" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="14,11,0,11"/>
                                            <Border Grid.Column="1" Background="{DynamicResource ThemeSubtleBg}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="0,0,8,0">
                                                <TextBlock x:Name="TxtVersionBadge" Text="v0.0.0" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}"/>
                                            </Border>
                                            <TextBlock x:Name="TxtArrowAbout" Grid.Column="2" Text="▶" FontSize="10" Foreground="{DynamicResource ThemeTextTertiary}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Grid>
                                    </Button>
                                    <StackPanel x:Name="SettingsAboutContent" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="14,0,14,12">
                                        <!-- 1. 品牌 Banner 标牌区 -->
                                        <Border x:Name="AboutBrandBanner" Background="{DynamicResource ThemeSubtleBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 品牌 Logo 徽章 -->
                                                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource ThemePrimary}" VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#2563EB" Opacity="0.4"/>
                                                    </Border.Effect>
                                                    <TextBlock Text="H" FontSize="20" FontWeight="Bold" FontFamily="Cascadia Code, Consolas" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Haodo" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                                        <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="Pro Quota" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource ThemePrimary}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock x:Name="TxtAboutBrandDesc" Text="AI 账号配额监测与本地代理工具" FontSize="11" Foreground="{DynamicResource ThemeTextSecondary}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- 2. 信息结构卡片组 -->
                                        <StackPanel Margin="0,0,0,12">
                                            <!-- 作者 & 交流 -->
                                            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE77B;" FontSize="12" Foreground="{DynamicResource ThemeTextTertiary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="作者" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="北京林或西" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <!-- QQ群交流胶囊按钮 -->
                                                    <Button Grid.Column="1" Click="BtnQQGroup_Click" Style="{StaticResource BtnHeader}" Height="26" MinHeight="26" MaxHeight="26" Padding="8,0" Cursor="Hand" ToolTip="点击唤起 QQ 加入交流群（自动复制群号）">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8BD;" FontSize="11" Foreground="{DynamicResource ThemePrimary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                            <TextBlock x:Name="TxtQQGroupBtnText" Text="Quicker地球村 (QQ群: 453478357)" FontSize="11" Foreground="{DynamicResource ThemePrimary}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>

                                            <!-- 技术架构卡片 -->
                                            <Border Background="{DynamicResource ThemeCardBg}" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE94A;" FontSize="12" Foreground="{DynamicResource ThemeTextTertiary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="技术架构" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <!-- 关键技术小标签云 -->
                                                        <WrapPanel x:Name="WrapTechTags" VerticalAlignment="Center">
                                                            <Border Background="{DynamicResource ThemeSubtleBg}" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                                                                <TextBlock Text=".NET 10" FontSize="10" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource ThemeSubtleBg}" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                                                                <TextBlock Text="WPF" FontSize="10" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource ThemeSubtleBg}" CornerRadius="4" Padding="5,1" Margin="0,0,4,0">
                                                                <TextBlock Text="SingleFile" FontSize="10" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                            </Border>
                                                            <Border Background="{DynamicResource ThemeSubtleBg}" CornerRadius="4" Padding="5,1">
                                                                <TextBlock Text="Encrypted Storage" FontSize="10" FontFamily="Cascadia Code, Consolas" Foreground="{DynamicResource ThemeTextSecondary}"/>
                                                            </Border>
                                                        </WrapPanel>
                                                    </StackPanel>

                                                    <TextBlock x:Name="TxtTechDesc" Text="自绘无边框界面，Gemini Antigravity 配额实时监测与本地代理集成。" FontSize="11" Foreground="{DynamicResource ThemeTextTertiary}" TextWrapping="Wrap" LineHeight="16"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- 自动检查更新开关 -->
                                        <Grid Margin="0,0,0,10" HorizontalAlignment="Stretch">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="自动检查更新" FontSize="12" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource ThemeSegmentBg}" CornerRadius="7" Padding="3" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Button x:Name="BtnAutoCheckOff" Click="BtnAutoCheckOff_Click" Content="关闭" Style="{StaticResource BtnSegmentInactive}" Height="26" MinWidth="64" Padding="8,0"/>
                                                    <Button x:Name="BtnAutoCheckOn" Click="BtnAutoCheckOn_Click" Content="开启" Style="{StaticResource BtnSegmentActive}" Height="26" MinWidth="64" Padding="8,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Button Click="BtnCheckUpdate_Click" Style="{StaticResource BtnPrimary}" Height="32" MinHeight="32" MaxHeight="32" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip="检查新版本">
                                            <TextBlock x:Name="TxtCheckUpdateBtn" Text="检查更新" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </Button>

                                        <!-- 分隔线 -->
                                        <Border Height="1" Background="{DynamicResource ThemeCardBorder}" Margin="0,12,0,10"/>

                                        <!-- 重置软件内嵌区域 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="重置软件" FontSize="12" FontWeight="SemiBold" Foreground="#E5484D" VerticalAlignment="Center"/>
                                                <TextBlock Text="清空所有已导入的凭证与本地设置，恢复初始状态。" FontSize="11" Foreground="{DynamicResource ThemeTextTertiary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Click="BtnResetInitialData_Click" Style="{StaticResource BtnHeader}" Height="30" MinHeight="30" MaxHeight="30" Padding="12,0" FontSize="11" Foreground="#E5484D" VerticalAlignment="Center" Cursor="Hand" ToolTip="清空所有凭证文件与本地设置（不可撤销）">
                                                <TextBlock Text="恢复出厂设置" VerticalAlignment="Center" Foreground="#E5484D" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
        </Grid>
            </Grid>
<Grid x:Name="GridCustomModalOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent">
            <Border Background="{DynamicResource ThemeOverlayBg}" CornerRadius="12"/>
            <Border MinWidth="300" MaxWidth="380" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource ThemeCardBg}" CornerRadius="12" Padding="20" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <StackPanel HorizontalAlignment="Stretch">
                    <!-- Header -->
                    <TextBlock x:Name="TxtModalTitle" Text="提示" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,10"/>

                    <!-- Message Content -->
                    <TextBlock x:Name="TxtModalMessage" Text="消息内容" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,18"/>

                    <!-- Action Buttons（最多三个：取消/确认/确定，列宽自适应） -->
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnModalCancel" Grid.Column="0" Click="BtnCloseCustomModal_Click" Style="{StaticResource BtnHeader}" Content="取消" Height="34" MinHeight="34" MaxHeight="34" HorizontalAlignment="Stretch" Margin="0,0,8,0" Visibility="Collapsed"/>
                        <Button x:Name="BtnModalOk" Grid.Column="0" Grid.ColumnSpan="3" Click="BtnModalOk_Click" Style="{StaticResource BtnPrimary}" Content="我知道了" Height="34" MinHeight="34" MaxHeight="34" HorizontalAlignment="Stretch"/>
                        <Button x:Name="BtnModalConfirm" Grid.Column="1" Click="BtnModalConfirm_Click" Style="{StaticResource BtnPrimary}" Content="确认" Height="34" MinHeight="34" MaxHeight="34" HorizontalAlignment="Stretch" Margin="0,0,8,0" Visibility="Collapsed"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
<Grid x:Name="GridUpdateOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="Transparent">
            <Border Background="{DynamicResource ThemeOverlayBg}" CornerRadius="12"/>
            <Border MinWidth="340" MaxWidth="380" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource ThemeCardBg}" CornerRadius="14" Padding="22,20" BorderBrush="{DynamicResource ThemeCardBorder}" BorderThickness="1" SnapsToDevicePixels="True" UseLayoutRounding="True">
                <StackPanel HorizontalAlignment="Stretch">
                    <!-- Header -->
                    <Grid Margin="0,0,0,14" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUpdateModalTitle" Text="发现新版本 v1.0.8" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource ThemeSubtleBg}" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtUpdateDate" Text="最新版本" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ThemeTextSecondary}" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Changelog Title & Box -->
                    <TextBlock Text="更新日志" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemeTextPrimary}" Margin="0,0,0,6"/>
                    <Border Background="{DynamicResource ThemeSubtleBg}" CornerRadius="8" Padding="12,10" Margin="0,0,0,18" MaxHeight="160">
                        <ScrollViewer Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtUpdateChangelog" Text="1. 修复已知问题。&#10;2. 增加了一些新的特性。" FontSize="12" Foreground="{DynamicResource ThemeTextSecondary}" TextWrapping="Wrap" LineHeight="20"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Progress Indicator -->
                    <TextBlock x:Name="TxtUpdateProgress" Visibility="Collapsed" Text="⏳ 正在下载最新版本..." FontSize="12" FontWeight="Bold" Foreground="{DynamicResource ThemePrimary}" HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <!-- Action Buttons -->
                    <Grid x:Name="GridUpdateButtons" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Click="BtnCancelUpdate_Click" Style="{StaticResource BtnHeader}" Content="暂不更新" Height="36" MinHeight="36" MaxHeight="36" Margin="0,0,4,0" HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1" x:Name="BtnConfirmUpdate" Click="BtnConfirmUpdate_Click" Style="{StaticResource BtnPrimary}" Content="立即更新" Height="36" MinHeight="36" MaxHeight="36" Margin="4,0,0,0" HorizontalAlignment="Stretch"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        </Grid>
        </Border>
    </Grid>
</Window>
